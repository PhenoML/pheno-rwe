# Preferred PhenoML authentication
PHENOML_CLIENT_ID=
PHENOML_CLIENT_SECRET=

PHENOML_BASE_URL=https://phenohealth.app.pheno.ml
# Live-client safety controls (bounded retries; Retry-After is capped by max wait)
PHENOML_TIMEOUT_SECONDS=300
PHENOML_MAX_RPS=2
PHENOML_RETRY_MAX_ATTEMPTS=5
PHENOML_RETRY_BASE_SECONDS=0.5
PHENOML_RETRY_MAX_WAIT_SECONDS=30
FHIR_PROVIDER_ID=
